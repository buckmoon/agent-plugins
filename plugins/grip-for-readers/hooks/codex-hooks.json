{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|mcp__github__add_issue_comment|mcp__github__add_reply_to_pull_request_comment|mcp__github__create_pull_request|mcp__github__update_pull_request|mcp__github__issue_write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex.py\" pre",
            "timeout": 180,
            "statusMessage": "送る前の試し読みをしています…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
